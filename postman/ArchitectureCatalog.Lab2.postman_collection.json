{
  "info": {
    "name": "Architecture Catalog API - Lab 2 (Auth)",
    "description": "Lab 2 JWT auth demos. Start API: dotnet run (http://localhost:5080)\n\nSeed users:\n- admin / Admin123!\n- user1 / User123!\n\nRun folder \"0. Auth demo flow\" in order for defense.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "userAccessToken", "value": "" },
    { "key": "userRefreshToken", "value": "" },
    { "key": "styleId", "value": "1" },
    { "key": "buildingId", "value": "1" },
    { "key": "commentId", "value": "1" },
    { "key": "foreignCommentId", "value": "1" }
  ],
  "item": [
    {
      "name": "0. Auth demo flow",
      "item": [
        {
          "name": "01 LOGIN admin (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "pm.collectionVariables.set('adminAccessToken', json.accessToken);",
                  "pm.test('Has access + refresh', () => {",
                  "  pm.expect(json.accessToken).to.be.a('string');",
                  "  pm.expect(json.refreshToken).to.be.a('string');",
                  "  pm.expect(json.role).to.eql('Administrator');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "02 LOGIN user1 (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('userAccessToken', json.accessToken);",
                  "pm.collectionVariables.set('userRefreshToken', json.refreshToken);",
                  "pm.test('Role is User', () => pm.expect(json.role).to.eql('User'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"User123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "03 401 create style WITHOUT token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Fail\",\n  \"description\": \"No token\",\n  \"startYear\": 1900,\n  \"endYear\": 1950\n}"
            },
            "url": "{{baseUrl}}/api/architectural-styles"
          }
        },
        {
          "name": "04 403 create style AS user1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{userAccessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Fail Forbidden\",\n  \"description\": \"User role\",\n  \"startYear\": 1900,\n  \"endYear\": 1950\n}"
            },
            "url": "{{baseUrl}}/api/architectural-styles"
          }
        },
        {
          "name": "05 201 create style AS admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('styleId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Auth Style\",\n  \"description\": \"Created by admin in Lab 2 demo\",\n  \"startYear\": 1980,\n  \"endYear\": 2000\n}"
            },
            "url": "{{baseUrl}}/api/architectural-styles"
          }
        },
