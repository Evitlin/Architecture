    {
      "name": "2. ArchitecturalStyles (protected writes)",
      "item": [
        {
          "name": "GET all",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/architectural-styles?page=1&pageSize=10"
          }
        },
        {
          "name": "POST create (admin Bearer)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Style\",\n  \"description\": \"Created from Postman\",\n  \"startYear\": 1900,\n  \"endYear\": 1950\n}"
            },
            "url": "{{baseUrl}}/api/architectural-styles"
          }
        },
        {
          "name": "PUT update (admin Bearer)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Style Updated\",\n  \"description\": \"Updated from Postman\",\n  \"startYear\": 1900,\n  \"endYear\": 1960\n}"
            },
            "url": "{{baseUrl}}/api/architectural-styles/{{styleId}}"
          }
        },
        {
          "name": "DELETE (admin Bearer)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/architectural-styles/{{styleId}}"
          }
        }
      ]
    },
