    <changeSet id="002-seed-data" author="evigai">
        <!-- Architectural styles (10) -->
        <insert tableName="architectural_styles">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="Gothic"/>
            <column name="description" value="Medieval style with pointed arches, ribbed vaults, and flying buttresses."/>
            <column name="start_year" valueNumeric="1140"/>
            <column name="end_year" valueNumeric="1500"/>
        </insert>
        <insert tableName="architectural_styles">
            <column name="id" valueNumeric="2"/>
            <column name="name" value="Renaissance"/>
            <column name="description" value="Revival of classical Roman forms with symmetry, proportion, and geometric clarity."/>
            <column name="start_year" valueNumeric="1400"/>
            <column name="end_year" valueNumeric="1600"/>
        </insert>
        <insert tableName="architectural_styles">
            <column name="id" valueNumeric="3"/>
            <column name="name" value="Baroque"/>
            <column name="description" value="Dramatic, ornate style with curves, grandeur, and strong light-shadow contrast."/>
            <column name="start_year" valueNumeric="1600"/>
            <column name="end_year" valueNumeric="1750"/>
        </insert>
        <insert tableName="architectural_styles">
            <column name="id" valueNumeric="4"/>
            <column name="name" value="Neoclassicism"/>
            <column name="description" value="Return to Greco-Roman ideals: columns, pediments, and restrained decoration."/>
            <column name="start_year" valueNumeric="1750"/>
            <column name="end_year" valueNumeric="1850"/>
        </insert>
        <insert tableName="architectural_styles">
            <column name="id" valueNumeric="5"/>
            <column name="name" value="Historicism"/>
            <column name="description" value="19th-century approach that freely mixes earlier historical styles."/>
            <column name="start_year" valueNumeric="1830"/>
            <column name="end_year" valueNumeric="1900"/>
        </insert>
        <insert tableName="architectural_styles">
            <column name="id" valueNumeric="6"/>
            <column name="name" value="Art Nouveau"/>
            <column name="description" value="Organic curves, floral motifs, and craftsmanship typical of the fin de siècle."/>
            <column name="start_year" valueNumeric="1890"/>
            <column name="end_year" valueNumeric="1914"/>
        </insert>
        <insert tableName="architectural_styles">
            <column name="id" valueNumeric="7"/>
            <column name="name" value="Modernism"/>
            <column name="description" value="Functional forms, little ornament, new materials such as steel, glass, and concrete."/>
            <column name="start_year" valueNumeric="1918"/>
            <column name="end_year" valueNumeric="1970"/>
        </insert>
        <insert tableName="architectural_styles">
            <column name="id" valueNumeric="8"/>
            <column name="name" value="Brutalism"/>
            <column name="description" value="Raw concrete (béton brut), monumental massing, and honest structural expression."/>
            <column name="start_year" valueNumeric="1950"/>
            <column name="end_year" valueNumeric="1980"/>
        </insert>
        <insert tableName="architectural_styles">
            <column name="id" valueNumeric="9"/>
            <column name="name" value="Postmodernism"/>
            <column name="description" value="Playful references to history, color, and irony as a reaction to strict modernism."/>
            <column name="start_year" valueNumeric="1970"/>
            <column name="end_year" valueNumeric="1995"/>
        </insert>
        <insert tableName="architectural_styles">
            <column name="id" valueNumeric="10"/>
            <column name="name" value="Contemporary"/>
            <column name="description" value="Present-day architecture focusing on sustainability, technology, and context."/>
            <column name="start_year" valueNumeric="1995"/>
            <column name="end_year" valueNumeric="2100"/>
        </insert>

